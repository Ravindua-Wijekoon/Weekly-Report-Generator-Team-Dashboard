{
  "info": {
    "name": "Weekly Report Generator API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('projectId', body.project._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Client A\",\n  \"description\": \"Work for Client A\"\n}"
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Create Draft Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('reportId', body.report._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/reports", "host": ["{{baseUrl}}"], "path": ["reports"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": \"{{projectId}}\"\n}"
            }
          }
        },
        {
          "name": "List Reports",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports", "host": ["{{baseUrl}}"], "path": ["reports"] }
          }
        },
        {
          "name": "Get Report",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Update Report Content",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": {\n    \"tasksCompleted\": [\n      {\n        \"name\": \"Build login page\",\n        \"priority\": \"high\",\n        \"plannedPercent\": 100,\n        \"actualPercent\": 100,\n        \"status\": \"completed\",\n        \"timePlannedHours\": 8,\n        \"timeSpentHours\": 10,\n        \"output\": \"Login and register pages\"\n      }\n    ],\n    \"tasksPlannedNextWeek\": [\n      { \"text\": \"Start on report CRUD\" }\n    ],\n    \"blockers\": [\n      { \"text\": \"Waiting on design review\", \"isKey\": true }\n    ],\n    \"achievements\": [\n      { \"text\": \"Finished auth end to end\", \"isKey\": true }\n    ],\n    \"hoursByType\": {\n      \"development\": 30,\n      \"testing\": 4,\n      \"meetings\": 3,\n      \"documentation\": 2\n    },\n    \"notes\": \"Nothing else to add\"\n  }\n}"
            }
          }
        },
        {
          "name": "Submit Report",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}", "submit"]
            }
          }
        },
        {
          "name": "Review Report (Approve)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}", "review"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            }
          }
        },
        {
          "name": "Review Report (Request Changes)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}", "review"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"request_changes\",\n  \"comment\": \"Please add more detail on tasks completed\"\n}"
            }
          }
        },
        {
          "name": "Get Report Versions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/{{reportId}}/versions",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{reportId}}", "versions"]
            }
          }
        }
      ]
    }
  ]
}
